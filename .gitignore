# Python
__pycache__

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.backup
*.bak
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Exception: value presets committed under a module's presets/ directory are
# intentional, non-secret inputs. They are consumed by the module's `preset`
# input and are also valid `terraform -var-file` files. Keep them free of real
# credentials.
!terraform/**/presets/*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc
.terraform.lock.hcl

terraform/testing/**