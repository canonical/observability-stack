#!/usr/bin/env bash
# SolQA entry point: run the solution tests against the deployed "cos" model.
# Output: test_results.xml (JUnit), which SolQA keeps with the run.
# Exit code: pytest's, so SolQA's "Run SQA tests" step fails if any test fails.
# Usage: ./sqa_tests [cos|cos-lite] [pytest args]; defaults to $PRODUCT.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"
rm -f test_results.xml

MODEL="cos"
# SolQA's runners have Python 3.10; the tests need 3.12.
UV_FLAGS=(--frozen --isolated --python 3.12)

solution="${1:-${PRODUCT:-}}"
if [ $# -gt 0 ]; then shift; fi
# SolQA deploys terraform/<solution> with its defaults: internal TLS, no external CA, and the
# default ingress. There's no Terraform wrapper state here to read that from, so state it in
# the shape of the wrapper's outputs (see tests/solution/<solution>/terraform/outputs.tf).
case "$solution" in
    cos)
        ingress='{"alertmanager": true, "catalogue": true, "grafana": true, "loki": true, "mimir": true, "opentelemetry_collector": true, "tempo": false}'
        ;;
    cos-lite)
        ingress='{"alertmanager": true, "catalogue": true, "grafana": true, "loki": true, "opentelemetry_collector": true, "prometheus": true}'
        ;;
    *)
        echo "ERROR: unknown solution '$solution'; pass cos or cos-lite, or set PRODUCT" >&2
        exit 1
        ;;
esac
export SOLUTION_MODE='{"internal_tls": true, "tls_termination": false, "ingress": '"$ingress"', "optional_apps": {"traefik": true}}'

# SolQA's runner can reach Traefik's load balancer address but not the pods, so leave out the
# scenarios that need a pod: the internal-TLS certificate checks connect to each unit, and
# Tempo has no ingress in COS. The candidate quality gate still runs them.
NEEDS_POD="units_serve_certificates_from_the_internal_ca or tempo_collects_traces"

if ! command -v uv &> /dev/null; then
    echo "Installing astral-uv (snap, provides 'uv')..."
    sudo snap install astral-uv --classic
fi

# The tests wait for the model to be active and idle before checking anything.
cd tests/solution
SOLUTION_MODEL="$MODEL" uv run "${UV_FLAGS[@]}" pytest -vv -ra "$solution" \
    -k "not ($NEEDS_POD)" --junitxml="$SCRIPT_DIR/test_results.xml" "$@"
